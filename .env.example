# Node.js 24.15+ with a persistent local disk
DATABASE_PATH=.data/clinic.sqlite
# Set to the exact public HTTPS origin when deploying:
# SITE_URL=https://your-domain.com
# COOKIE_SECURE=true
# TRUST_PROXY=true only behind your own proxy that overwrites forwarding headers
# Optional for initial setup only. Otherwise a strong password is generated locally.
# OWNER_USERNAME=owner
# OWNER_PASSWORD=
